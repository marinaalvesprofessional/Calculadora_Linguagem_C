#include <stdio.h>
#include <math.h>

// 1. Soma
double soma(double a, double b) {
    return a + b;
}

// 2. Subtração
double subtracao(double a, double b) {
    return a - b;
}

// 3. Multiplicação
double multiplicacao(double a, double b) {
    return a * b;
}

// 4. Divisão
double divisao(double a, double b) {
    if (b == 0) {
        printf("Erro: divisao por zero!\n");
        return 0;
    }
    return a / b;
}

// 5. Potência
double potencia(double a, double b) {
    return pow(a, b);
}

// 6. Raiz quadrada
double raiz(double a) {
    if (a < 0) {
        printf("Erro: numero negativo!\n");
        return 0;
    }
    return sqrt(a);
}

// 7. Porcentagem
double porcentagem(double a, double b) {
    return (a * b) / 100;
}

// 8. Fatorial
unsigned long long fatorial(int n) {
    unsigned long long resultado = 1;

    for (int i = 1; i <= n; i++) {
        resultado *= i;
    }

    return resultado;
}

// 9. Resto da divisao
int resto(int a, int b) {
    if (b == 0) {
        printf("Erro: divisao por zero!\n");
        return 0;
    }
    return a % b;
}

// 10. Logaritmo
double logaritmo(double a) {
    if (a <= 0) {
        printf("Erro: valor invalido!\n");
        return 0;
    }
    return log(a);
}

// 11. Seno
double seno(double a) {
    return sin(a * M_PI / 180);
}

// 12. Cosseno
double cosseno(double a) {
    return cos(a * M_PI / 180);
}

// 13. Tangente
double tangente(double a) {
    return tan(a * M_PI / 180);
}

// 14. Valor absoluto
double absoluto(double a) {
    return fabs(a);
}

// 15. Arredondamento
double arredondar(double a) {
    return round(a);
}

// 16. Piso
double piso(double a) {
    return floor(a);
}

// 17. Teto
double teto(double a) {
    return ceil(a);
}

// 18. Inverso
double inverso(double a) {
    if (a == 0) {
        printf("Erro: nao existe inverso de zero!\n");
        return 0;
    }
    return 1 / a;
}

// 19. Media
double media(double a, double b) {
    return (a + b) / 2;
}

// 20. Exponencial
double exponencial(double a) {
    return exp(a);
}


